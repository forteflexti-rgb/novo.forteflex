# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication tokens on the Express server.
JWT_SECRET="change-this-in-production-to-a-strong-random-secret"

# SUPABASE (Optional for direct Supabase PostgreSQL + Supabase Auth mode on Vercel)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
